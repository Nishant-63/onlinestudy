# Required for startup (validation will fail if missing):
#   JWT_SECRET
#   DATABASE_URL (or DB_HOST, DB_NAME, DB_USER, DB_PASSWORD)

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=onlinestudy
DB_USER=postgres
DB_PASSWORD=password

# Or use a single connection string (overrides above):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Configuration (required)
JWT_SECRET=your-super-secret-jwt-key-here
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 Configuration
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_BUCKET=onlinestudy-files
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=nyc3

# Redis Configuration (for job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Configuration
PORT=3001
NODE_ENV=development

# File Upload Limits
MAX_VIDEO_SIZE=10737418240
MAX_PDF_SIZE=524288000
MAX_STUDENT_PDF_SIZE=524288000

# Video Processing
FFMPEG_PATH=/usr/bin/ffmpeg
HLS_SEGMENT_DURATION=10
